# Copy this file to config.properties (next to pom.xml) and fill it in.
# config.properties is git-ignored – never commit your session cookie.
# Anything here overrides src/main/resources/application.properties.

leetvise.username=recusant_byte

# Optional but recommended: loads ALL your solved problems (not just the last ~20).
# leetcode.com -> DevTools (F12) -> Application -> Cookies -> https://leetcode.com
# Copy the values of LEETCODE_SESSION and csrftoken.
# (Or leave these out and set the LEETCODE_SESSION / LEETCODE_CSRF environment variables.)
#leetvise.session=
#leetvise.csrftoken=

# Where the Excel "table" lives. Default: data/leetvise.xlsx inside the project.
#leetvise.excel=data/leetvise.xlsx

#server.port=8181
#leetvise.open-browser=true
