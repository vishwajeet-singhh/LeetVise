# LeetVise – revise the LeetCode problems you've already solved.
#
# Author:    Vishwajeet Pratap Singh
# GitHub:    https://github.com/vishwajeet-singhh
# LinkedIn:  https://www.linkedin.com/in/vishwajeetsage/
# Portfolio: https://vishwajeet.me
# Source:    https://github.com/vishwajeet-singhh/LeetVise

# LeetVise settings. Copy this file to .env (same folder) and fill it in – .env is git-ignored.
# Format: KEY=value, one per line. No quotes or "export" needed.

# Your LeetCode username. Optional: with LEETCODE_SESSION set it is detected automatically,
# otherwise the app asks for it the first time you open it.
LEETCODE_USERNAME=

# Optional but recommended: loads every problem you've solved plus your full submission history
# (wrong answers, TLEs, retries…), which powers the Insights page.
# leetcode.com -> log in -> DevTools (F12) -> Application -> Cookies -> https://leetcode.com
# Copy the values of the LEETCODE_SESSION and csrftoken cookies. Treat them like a password.
LEETCODE_SESSION=
LEETCODE_CSRF=

# Where the Excel workbook lives, relative to this folder. Default: data/leetvise.xlsx
#LEETVISE_EXCEL=data/leetvise.xlsx

# Port for the local web UI. Default: 8181
#LEETVISE_PORT=8181

# Open the browser automatically on start. Default: true
#LEETVISE_OPEN_BROWSER=true

# LeetVise · by Vishwajeet Pratap Singh · github.com/vishwajeet-singhh · linkedin.com/in/vishwajeetsage · vishwajeet.me
